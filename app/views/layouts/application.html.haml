!!! 5
%html
  %head
    %title= "UA" #full_title(@title)
    :javascript
      console.log('test9')
    :javascript
      var Guide = {route: #{raw Rails.application.routes.recognize_path(request.url,method: request.env["REQUEST_METHOD"]).to_json}};
    -# = javascript_include_tag "application" #, 'data-turbolinks-track': 'reload'
    -# = stylesheet_link_tag "application", media: "all" #, 'data-turbolinks-track': 'reload'
    %link{ rel: 'icon', type: 'image/svg+xml', href: '/icon.svg' }
    %link{ rel: 'icon', type: 'image/png', sizes: '512x512', href: '/icon.png' }
    = csrf_meta_tag
    -# The SAD/ASR promise service and the bucket it works through. Read by
    -# app/javascript/lib/ldcjs/service_config.js, the same way getp.js reads
    -# the CSRF token. Configured in config/application.rb.
    %meta{ name: 'hlt-endpoint',   content: Rails.application.config.x.hlt_endpoint }
    %meta{ name: 'promise-bucket', content: Rails.application.config.x.promise_bucket }
    -# Whether s3:// sources and the bucket browser can work at all. The browser
    -# reaches S3 only through POST /token, so without Cognito and a region they
    -# are dead — and used to fail as a TypeError on undefined rather than saying so.
    %meta{ name: 's3-available', content: cognito_configured?.to_s }
    = javascript_tag "var AUTH_TOKEN = '#{form_authenticity_token}';" if protect_against_forgery?
    = javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.js'
    = javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js'
    = javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/marked/4.0.2/marked.min.js'
    = javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/aws-sdk/2.1050.0/aws-sdk.min.js'
    -# = javascript_include_tag 'https://cdnjs.cloudflare.com/ajax/libs/js-bson/2.0.8/bson.min.js'
    -# = javascript_include_tag 'https://cdn.jsdelivr.net/npm/dsp.js@1.0.1'
    - if Rails.env.development?
      = vite_client_tag
    = vite_javascript_tag 'application'
    -# = vite_stylesheet_tag 'application'
    = yield(:head)#allows content_for tag to send page specific js/css include statements
    -# = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    -# = stylesheet_link_tag "inter-font"
    -# = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    %meta{:name =>"viewport", :content => "width=device-width, initial-scale=1, maximum-scale=1"}
  %body.px-4.bg-white
    -# Sign-out form lives here, hidden, so the keybinding can submit it.
    #newsignout{ style: 'display: none' }
      = button_to "Sign out", session_path, method: :delete if authenticated?
    - if signed_in?
      -# userid is here so the client can gate anything that's still being tried out — see the Graph button in the waveform header.
      #headerdata{ data: { user: current_user.name, userid: current_user.id, kitid: @kit&.id, kituid: @kit&.uid, locked: @kit&.tree&.locked } }
    #main-wrapper
      #main
        - flash.each do |key, value|
          - if key == 'error' or key == 'danger'
            .flash{ :class => "bg-red-300 relative rounded" }
              .text-center
                =value
              .absolute.top-0.right-0.pr-2
                %button.close &times;
          - else
            .flash{ :class => "bg-green-300 relative rounded" }
              .text-center
                =value
              .absolute.top-0.right-0.pr-2
                %button.close &times;
        = yield
    -# flash messages were broken by the upgrade, not sure why. This change fixed them.
    / = render 'layouts/footer'
    -if false # Rails.env.development?
      .full
        =debug(params)
    %script= yield :action_specific_js#allows for page specific javascript to be run after the body is loaded
