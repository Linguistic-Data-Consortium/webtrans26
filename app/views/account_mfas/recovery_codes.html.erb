<%# Recovery codes, shown this once (AccountMfasController#create / #recovery_codes).
    Only their digests are stored. %>
<div class="min-h-screen bg-gray-50 py-1 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
    <h2 class="mt-1 text-3xl font-bold tracking-tight text-gray-900">Save your recovery codes</h2>
    <p class="mt-2 text-sm text-gray-600">
      If you lose your phone, each of these signs you in once in place of a code.
      <strong>This is the only time they're shown</strong> — keep them somewhere safe, like a password manager.
    </p>
  </div>
  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-6 px-4 shadow sm:rounded-lg sm:px-10 space-y-5">
      <ul class="grid grid-cols-2 gap-2 font-mono text-base text-center" id="recovery-codes">
        <% @codes.each do |code| %><li class="rounded bg-gray-100 py-1"><%= code %></li><% end %>
      </ul>
      <%= link_to "I've saved them — continue", root_path, class: "flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-indigo-500" %>
    </div>
  </div>
</div>
