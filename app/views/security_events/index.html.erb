<%# The security audit log (SecurityEventsController), system admins only. %>
<div class="mx-auto max-w-7xl py-4">
  <div class="flex items-baseline justify-between">
    <h2 class="text-2xl font-bold text-gray-900">Security log</h2>
    <%= link_to "Back to the dashboard", root_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
  </div>

  <%= form_with url: security_events_path, method: :get, local: true, class: "mt-4 flex flex-wrap items-end gap-3 text-sm" do |f| %>
    <div>
      <%= f.label :event, "Event", class: "block text-gray-600" %>
      <%= f.select :event, options_for_select([ [ "All events", "" ] ] + SecurityEvent::EVENTS.map { |k, v| [ "#{k} — #{v}", k ] }, params[:event]),
          {}, class: "rounded border-gray-300 py-1" %>
    </div>
    <div>
      <%= f.label :user, "User (name or email)", class: "block text-gray-600" %>
      <%= f.text_field :user, value: params[:user], class: "rounded border border-gray-300 px-2 py-1" %>
    </div>
    <div>
      <%= f.label :from, "From", class: "block text-gray-600" %>
      <%= f.date_field :from, value: params[:from], class: "rounded border border-gray-300 px-2 py-1" %>
    </div>
    <div>
      <%= f.label :to, "To", class: "block text-gray-600" %>
      <%= f.date_field :to, value: params[:to], class: "rounded border border-gray-300 px-2 py-1" %>
    </div>
    <%= f.submit "Filter", name: nil, class: "rounded bg-indigo-600 px-3 py-1 font-semibold text-white hover:bg-indigo-500" %>
    <%= link_to "Download CSV", security_events_path(request.query_parameters.except("page").merge(format: :csv)),
        class: "text-indigo-600 hover:text-indigo-500" %>
  <% end %>

  <p class="mt-3 text-sm text-gray-600">
    <%= pluralize(@total, "event") %><% if @total > SecurityEventsController::PER_PAGE %>, page <%= @page %><% end %>. Times are UTC.
  </p>

  <table class="mt-2 w-full text-sm" id="security-events">
    <thead>
      <tr class="border-b text-left text-gray-600">
        <th class="py-1 pr-3">Time (UTC)</th><th class="py-1 pr-3">Event</th><th class="py-1 pr-3">User</th>
        <th class="py-1 pr-3">By</th><th class="py-1 pr-3">IP</th><th class="py-1">Details</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |e| %>
        <tr class="border-b align-top">
          <td class="py-1 pr-3 whitespace-nowrap"><%= e.created_at.utc.strftime("%Y-%m-%d %H:%M:%S") %></td>
          <td class="py-1 pr-3"><span class="font-mono"><%= e.event %></span><div class="text-xs text-gray-500"><%= e.description %></div></td>
          <td class="py-1 pr-3"><%= e.user&.email_address || (e.user_id ? "user ##{e.user_id}" : "—") %></td>
          <td class="py-1 pr-3"><%= e.actor&.email_address || "—" %></td>
          <td class="py-1 pr-3 font-mono" title="<%= e.user_agent %>"><%= e.ip %></td>
          <td class="py-1 font-mono text-xs"><%= e.details&.map { |k, v| "#{k}: #{v}" }&.join(", ") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="mt-3 flex gap-4 text-sm">
    <% if @page > 1 %><%= link_to "← Newer", security_events_path(request.query_parameters.merge(page: @page - 1)), class: "text-indigo-600" %><% end %>
    <% if @page * SecurityEventsController::PER_PAGE < @total %><%= link_to "Older →", security_events_path(request.query_parameters.merge(page: @page + 1)), class: "text-indigo-600" %><% end %>
  </div>
</div>
