:css
  .doc-page { max-width: 80rem; margin: 0 auto; padding: 2rem 1rem; }
  .doc-layout { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .doc-layout { grid-template-columns: 14rem 1fr; } }

  .doc-sidebar {
    align-self: start;
    position: sticky; top: 1rem;
    max-height: calc(100vh - 2rem); overflow-y: auto;
  }
  .doc-sidebar h3 {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: #6b7280;
    margin: 1rem 0 0.5rem;
  }
  .doc-sidebar h3:first-child { margin-top: 0; }
  .doc-sidebar ul { list-style: none; padding: 0; margin: 0; }
  .doc-sidebar li { margin: 0.125rem 0; }
  .doc-sidebar a, .doc-sidebar .current {
    display: block; padding: 0.375rem 0.5rem; border-radius: 0.375rem;
    font-size: 0.875rem; line-height: 1.3; text-decoration: none;
  }
  .doc-sidebar a { color: #374151; }
  .doc-sidebar a:hover { background: #f3f4f6; }
  .doc-sidebar .current { background: #eef2ff; color: #312e81; font-weight: 600; }
  .doc-sidebar .back {
    display: inline-flex; align-items: center; gap: 0.35rem;
    color: #4f46e5; font-size: 0.85rem; font-weight: 500;
    padding: 0.25rem 0.5rem; border-radius: 0.375rem;
    margin-bottom: 0.5rem;
  }
  .doc-sidebar .back:hover { background: #eef2ff; }

  .doc-card {
    background: white; border: 1px solid #e5e7eb; border-radius: 0.75rem;
    padding: 2rem 2.25rem;
  }
  .doc-header {
    padding-bottom: 1rem; margin-bottom: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
  }
  .doc-header h1 {
    font-size: 1.875rem; font-weight: 700; color: #111827; margin: 0;
  }

  /* ----- Rendered markdown styling ----- */

  .doc-article {
    color: #1f2937; line-height: 1.7; font-size: 15px;
  }
  .doc-article > *:first-child { margin-top: 0; }
  .doc-article > *:last-child  { margin-bottom: 0; }

  .doc-article h1, .doc-article h2, .doc-article h3,
  .doc-article h4, .doc-article h5, .doc-article h6 {
    font-weight: 600; color: #111827; line-height: 1.3;
    margin-top: 2em; margin-bottom: 0.6em;
  }
  .doc-article h1 { font-size: 1.75rem; padding-bottom: 0.35em; border-bottom: 1px solid #e5e7eb; }
  .doc-article h2 { font-size: 1.35rem; padding-bottom: 0.3em;  border-bottom: 1px solid #e5e7eb; }
  .doc-article h3 { font-size: 1.15rem; }
  .doc-article h4 { font-size: 1rem; }

  .doc-article p,
  .doc-article ul, .doc-article ol,
  .doc-article blockquote, .doc-article table, .doc-article pre {
    margin-top: 0; margin-bottom: 1em;
  }

  .doc-article ul { list-style: disc;    padding-left: 1.5em; }
  .doc-article ol { list-style: decimal; padding-left: 1.5em; }
  .doc-article li { margin: 0.25em 0; }
  .doc-article li > p { margin: 0.25em 0; }
  .doc-article ul ul, .doc-article ol ol, .doc-article ul ol, .doc-article ol ul { margin: 0.25em 0; }

  .doc-article a { color: #4f46e5; text-decoration: none; }
  .doc-article a:hover { color: #3730a3; text-decoration: underline; }

  .doc-article code {
    background: #f3f4f6; color: #be185d;
    padding: 0.15em 0.4em; border-radius: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
  }
  .doc-article pre {
    background: #0f172a; color: #e5e7eb;
    padding: 1rem 1.25rem; border-radius: 0.5rem;
    overflow-x: auto; font-size: 0.85em; line-height: 1.55;
  }
  .doc-article pre code {
    background: transparent; color: inherit;
    padding: 0; border-radius: 0; font-size: 1em;
  }

  .doc-article blockquote {
    border-left: 4px solid #d1d5db; padding: 0.25em 1em;
    color: #4b5563; margin: 1em 0;
  }

  .doc-article table {
    border-collapse: collapse; width: 100%;
    font-size: 0.93em; display: block; overflow-x: auto;
  }
  .doc-article th, .doc-article td {
    border: 1px solid #e5e7eb; padding: 0.5em 0.85em; text-align: left;
  }
  .doc-article th { background: #f9fafb; font-weight: 600; }
  .doc-article tr:nth-child(2n) td { background: #fafafa; }

  .doc-article hr {
    border: 0; border-top: 1px solid #e5e7eb; margin: 2em 0;
  }

  .doc-article img { max-width: 100%; height: auto; border-radius: 0.375rem; }

  .doc-article kbd {
    background: white; border: 1px solid #d1d5db; border-bottom-width: 2px;
    border-radius: 0.25rem; padding: 0.1em 0.4em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em; color: #374151;
  }

.doc-page
  .doc-layout
    %aside.doc-sidebar
      - if authenticated? && current_user
        = link_to user_path(current_user), class: 'back' do
          %span ←
          %span Back to your page
      %h3 Docs
      %ul
        = render partial: 'doc_link', locals: { title: 'All docs', href: documentation_index_path, current: false }
        - @docs.each do |doc|
          = render partial: 'doc_link', locals: { title: doc[:title], href: documentation_show_path(doc[:slug]), current: doc[:slug] == @slug }

    %article.doc-card
      .doc-header
        %h1= @title
      .doc-article!= @html
