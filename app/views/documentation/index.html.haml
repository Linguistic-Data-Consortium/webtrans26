:css
  .doc-index { max-width: 48rem; margin: 0 auto; padding: 2.5rem 1rem; }
  .doc-index h1 {
    font-size: 1.875rem; font-weight: 700; color: #111827; margin: 0 0 0.25rem;
  }
  .doc-index .lead { color: #6b7280; font-size: 0.95rem; margin-bottom: 1.5rem; }
  .doc-index ul {
    list-style: none; padding: 0; margin: 0;
    background: white; border: 1px solid #e5e7eb; border-radius: 0.75rem;
  }
  .doc-index li {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1.25rem; border-bottom: 1px solid #f1f5f9;
  }
  .doc-index li:last-child { border-bottom: 0; }
  .doc-index li:hover { background: #fafafa; }
  .doc-index .title { color: #4338ca; text-decoration: none; font-weight: 600; }
  .doc-index .title:hover { color: #312e81; text-decoration: underline; }
  .doc-index .empty { color: #6b7280; }

.doc-index
  %h1 Documentation

  - if @docs.any?
    %ul
      - @docs.each do |doc|
        %li
          = link_to doc[:title], documentation_show_path(doc[:slug]), class: 'title'
  - else
    %p.empty No documentation files found in docs/.
