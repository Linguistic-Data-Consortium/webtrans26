{
  "LaunchTemplateName": "vm_for_kamal_deployment",
  "VersionDescription": "example vm template for kamal deployment",
  "LaunchTemplateData": {
    "KeyName": "$key_pair_name",
    "SecurityGroupIds": [
      "$ingress_sg_id",
      "$egress_sg_id"
    ],
    "UserData": "",
    "BlockDeviceMappings": [
      {
        "DeviceName": "/dev/sda1",
        "Ebs": {
          "Encrypted": true,
          "DeleteOnTermination": false,
          "KmsKeyId": "alias/aws/ebs",
          "VolumeSize": 15,
          "VolumeType": "gp3"
        }
      }
    ],
    "InstanceType": "t3a.small",
    "ImageId": "$ami_id",
    "EbsOptimized": true,
    "MetadataOptions": {
      "HttpPutResponseHopLimit": 2
    },
    "InstanceInitiatedShutdownBehavior": "stop"
  }
}
