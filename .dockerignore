# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# TLS certificates and keys (docs/DEPLOYMENT.md puts them in config/): Kamal's
# proxy serves them, so the image never needs them, and a pulled image shouldn't hand out the key.
/config/*.pem
/config/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Built JS/CSS. assets:precompile generates public/vite in the image, so
# copying the host's gives two generations of every chunk — and public/vite-dev
# and public/vite-test, which production never serves. 56 MB of someone else's
# build, and it makes the image depend on whatever the host last built.
/public/vite*

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
